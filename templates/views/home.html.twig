{% extends 'partials/base.html.twig' %}

{% block body %}
    <table>
        {% for event in events %}
            <tr>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.internalCode }}</a></td>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.name }}</a></td>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.description }}</a></td>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.location }}</a></td>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.price }}</a></td>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.url }}</a></td>
                <td><a href="{{ path('event', {id: event.id}) }}">{{ event.holdingDate|date('d-m-Y') }}</a></td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
