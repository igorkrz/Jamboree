{% extends 'partials/base.html.twig' %}

{% block body %}
    <div class="container mx-auto p-4">
        <div class="flex justify-between items-center mb-4" data-controller="home">
            <div class="flex space-x-2">
                {% include 'components/button.html.twig' with {
                    id: 1,
                    action: 'home#export',
                    title: 'Export',
                    path: path('export_calendar'),
                    alt: 'export',
                } %}
                {% include 'components/button.html.twig' with {
                    id: 2,
                    action: 'home#filter',
                    title: 'Filter',
                    path: path('home'),
                    alt: 'filter',
                } %}
            </div>
        </div>
        <div id="calendar-holder" class="w-full"></div>
    </div>
{% endblock %}
