{% extends 'partials/base.html.twig' %}

{% block body %}
    <div class="container mx-auto p-4">
        <div class="bg-white shadow overflow-hidden sm:rounded-lg">
            <!-- Event Image -->
            <div class="flex justify-center">
                <img class="object-cover h-64 w-full sm:h-80 md:h-96 lg:h-128" src="{{ event.imageUrl ?? null }}" alt="{{ event.name ?? null }}">
            </div>

            <!-- Event Info -->
            <div class="px-4 py-5 sm:px-6">
                <h1 class="text-4xl font-bold text-gray-900">{{ event.name ?? null }}</h1>
                <p class="mt-1 text-lg text-gray-500">{{ event.holdingDate ? event.holdingDate|date('d-m-Y') : null }}</p>
            </div>
            <div class="border-t border-gray-200">
                <dl>
                    <div class="bg-gray-50 px-4 py-5 sm:px-6">
                        <dt class="text-lg font-medium text-gray-500">Description</dt>
                        <dd class="mt-1 text-lg text-gray-900">{{ event.description ?? null }}</dd>
                    </div>
                    <div class="bg-white px-4 py-5 sm:px-6">
                        <dt class="text-lg font-medium text-gray-500">Location</dt>
                        <dd class="mt-1 text-lg text-gray-900">{{ event.location ?? null }}</dd>
                    </div>
                    <div class="bg-gray-50 px-4 py-5 sm:px-6">
                        <dt class="text-lg font-medium text-gray-500">Price</dt>
                        <dd class="mt-1 text-lg text-gray-900">{{ event.price ?? null }}</dd>
                    </div>
                    <div class="bg-white px-4 py-5 sm:px-6">
                        <dt class="text-lg font-medium text-gray-500">Date</dt>
                        <dd class="mt-1 text-lg text-gray-900">{{ event.holdingDate|date('d-m-Y') }}</dd>
                    </div>
                    <div class="bg-gray-50 px-4 py-5 sm:px-6">
                        <dt class="text-lg font-medium text-gray-500">More Info</dt>
                        <dd class="mt-1 text-lg text-indigo-600 hover:text-indigo-900">
                            <a href="{{ event.url ?? null }}" target="_blank">Event Link</a>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}
