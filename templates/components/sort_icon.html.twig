<span class="cursor-pointer">{{ title }}</span>
<button class="w-4">
    {% set order = sortField == sortBy ? (sortOrder == 'ASC' ? 'DESC' : 'ASC') : 'DESC' %}
    <a href="{{ path('events', {
        sort: sortBy,
        order: order,
        page: page,
    }) }}">
        {% if sortField == sortBy and sortOrder == 'DESC' %}
            <img src="{{ asset('images/ChevronDown.svg') }}" alt="">
        {% else %}
            <img src="{{ asset('images/ChevronUp.svg') }}" alt="">
        {% endif %}
    </a>
</button>
